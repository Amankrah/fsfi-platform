 "schema": {
  "rule": "id, target, pattern. The pattern is a regular expression applied to the normalised text of the line (lower case, every non-alphanumeric character replaced by a space).",
  "targets": "IND-xx assigns the line to that indicator. NP marks a line with no first-order pathway to any indicator; it stays in the envelope and is placed by the residual stage. OH marks overhead, which is apportioned pro rata to the money of the same agency's other lines in the same sub-programme and year, then agency and year, then agency.",
  "order": "A line is assigned by the first rule that fires. Stages are tried in the order given; rules within a stage in list order.",
  "withheld_stages": {
   "PRE": "overrides keyed on agency codes and named facilities",
   "SUB": "rules on words of sub-programme names",
   "AGY": "agency code to indicator"
  },
  "withheld_rule_format": {
   "PRE": "id, target, pattern, optional set of agency codes, optional sub-programme pattern",
   "SUB": "id, target, pattern on the normalised sub-programme name",
   "AGY": "agency code: id, target"
  }
 },
